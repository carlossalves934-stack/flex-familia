  <div class="caixa">
    <div class="tela" id="player-tela"></div>
    <div class="lado">
      <h3 id="player-titulo"></h3>
      <span class="meta" id="player-meta"></span>
      <ul id="player-beneficios"></ul>
      <a class="yt" id="player-yt" target="_blank" rel="noopener">Assistir no YouTube ↗</a>
    </div>
  </div>
</div>
